# 이 파일을 .env로 복사한 뒤 값을 채워 주세요. .env는 커밋하지 않습니다.
#   cp .env.example .env
# 로컬 실행(./gradlew bootRun, uvicorn)과 docker compose 모두 이 .env를 읽습니다.

# LLM
ANTHROPIC_API_KEY=
# 팀 공통 모델 (Claude Sonnet 5.5). 바꿀 때는 팀에 먼저 공유합니다.
ANTHROPIC_MODEL=claude-sonnet-5-5

# DB (PostgreSQL + pgvector)
# POSTGRES_PASSWORD는 비워 두면 DB 컨테이너가 뜨지 않습니다. 로컬용 아무 값이나 넣으세요.
POSTGRES_DB=solution
POSTGRES_USER=solution
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# 로컬 실행 기준 DB 주소. docker compose 안에서는 자동으로 db로 바뀝니다.
DB_HOST=localhost

# 서버 포트·주소 (로컬 실행 기준)
BACKEND_PORT=8080
AI_SERVER_PORT=8000
AI_SERVER_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173

# 임베딩 모델은 KURE-v1(로컬 오픈소스)이라 키가 필요 없습니다.

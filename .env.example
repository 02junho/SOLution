# 이 파일을 .env로 복사한 뒤 값을 채워 주세요. .env는 커밋하지 않습니다.
#   cp .env.example .env
# 로컬 실행(./gradlew bootRun, uvicorn)과 docker compose 모두 이 .env를 읽습니다.

# LLM
ANTHROPIC_API_KEY=

# DB (PostgreSQL + pgvector)
# POSTGRES_PASSWORD는 비워 두면 DB 컨테이너가 뜨지 않습니다. 로컬용 아무 값이나 넣으세요.
POSTGRES_DB=solution
POSTGRES_USER=solution
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# 로컬 실행 기준 DB 주소. docker compose 안에서는 자동으로 db로 바뀝니다.
DB_HOST=localhost

# 서버 포트·주소 (로컬 실행 기준)
BACKEND_PORT=8080
AI_SERVER_PORT=8000
AI_SERVER_URL=http://localhost:8000
# 배포 서버에서는 브라우저로 여는 주소 (예: http://서버주소)
FRONTEND_ORIGIN=http://localhost:5173


# 시연용 기본 데이터 (매장 1곳 · 구매 업무 1001~1005). 로컬 확인·시연 서버에서만 true. 실제 매장 데이터를 쓰는 배포는 false
DEMO_SEED=false

# API 문서(/docs). 배포 서버에서는 false로 닫습니다.
# SWAGGER_ENABLED=false


# 임베딩 모델은 KURE-v1(로컬 오픈소스)이라 키가 필요 없습니다.
# 모델은 처음 한 번 Hugging Face에서 받아 model-cache 볼륨에 둡니다(2GB 넘음). 받을 때 속도 제한 경고를 없애려면 읽기용 토큰을 넣습니다(선택).
# HF_TOKEN=

